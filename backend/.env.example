# Chave usada para assinar os tokens JWT
# Gere uma aleatória: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave
TOKEN_EXPIRA_MINUTOS=120

# Caminho do banco SQLite
DATABASE_PATH=chat.db

# Provedor do modelo: "simulado" (padrão) ou "gemini"
LLM_PROVIDER=simulado

# Só necessário se LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SEGUNDOS=30
